# Compose-level settings. Never commit the real .env file.
PUBLIC_DOMAIN=your-domain.example
POSTGRES_DB=superbot
POSTGRES_USER=superbot
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD

# REAL execution capability is implemented but globally locked by default. Open only after every documented release gate.
LIVE_TRADING_ENABLED=false
MT5_DEMO_ONLY=true

