API_BASE_URL=https://YOUR_DOMAIN.example
MT5_ACCOUNT_LOGIN=12345678
MT5_SERVER=Broker-Demo
SYMBOLS=EURUSD,GBPUSD,USDJPY,XAUUSD
TIMEFRAMES=M5,M15,H1
POLL_SECONDS=30
EMA_FAST=20
EMA_SLOW=50
MIN_CONSENSUS=2
RISK_PER_TRADE_PERCENT=0.25
MAX_DAILY_LOSS_PERCENT=1.0
# 0 means no fixed application-side count cap. Broker margin and risk limits still apply.
MAX_OPEN_POSITIONS=3
MAX_OPEN_POSITIONS_PER_SYMBOL=1
# Aggregate initial-stop risk across all open bot positions (not a position-count cap).
MAX_TOTAL_OPEN_RISK_PERCENT=1.0
MAGIC_NUMBER=881611
DEVIATION_POINTS=20
HISTORY_LOOKBACK_DAYS=90
# Both modes default OFF. Start with DEMO and prove the broker-specific order path before considering REAL.
ENABLE_DEMO_EXECUTION=false
# REAL requires: production server gate + customer live-risk consent + these two local settings.
ENABLE_LIVE_EXECUTION=false
LIVE_TRADING_CONFIRMATION=
LOG_LEVEL=INFO
