APP_ENV=production
APP_NAME=SUPER TRADING BOT
DATABASE_URL=postgresql+psycopg://superbot:CHANGE_THIS_DB_PASSWORD@db:5432/superbot
AUTH_SECRET=REPLACE_WITH_64_RANDOM_CHARACTERS_OR_MORE
LICENSE_PEPPER=REPLACE_WITH_A_DIFFERENT_64_RANDOM_CHARACTERS_OR_MORE
JWT_ISSUER=super-trading-bot
ACCESS_TOKEN_MINUTES=720
PUBLIC_APP_URL=https://YOUR_DOMAIN.example
SUBSCRIPTION_PRICE_USD=0
PERFORMANCE_FEE_RATE=0.30
# Live execution capability is implemented in the Windows MT5 Agent. Server-side REAL permission remains OFF by default.
LIVE_TRADING_ENABLED=false
MT5_DEMO_ONLY=true
CORS_ORIGINS=https://YOUR_DOMAIN.example
TELEGRAM_BOT_TOKEN=
ADMIN_TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional conversational AI (OpenAI Chat Completions-compatible HTTPS endpoint).
AI_CHAT_API_URL=
AI_CHAT_API_KEY=
AI_CHAT_MODEL=
